": 1450.536, "end": 1453.584, "lang": "he", "text": "שׁוֹמֵעַ תְּפִלָּה וְתַחֲנוּן אָתָּה"}, {"start": 1458.576, "end": 1461.624, "lang": "he", "text": "שׁוֹמֵעַ תְּפִלָּה וְתַחֲנוּן אָתָּה"}, {"start": 1461.624, "end": 1464.912, "lang": "he", "text": "כִּי אֵל שׁוֹמֵעַ תְּפִלָּה וְתַחֲנוּן אָתָּה"}, {"start": 1470.912, "end": 1474.2, "lang": "he", "text": "כִּי אֵל שׁוֹמֵעַ תְּפִלָּה וְתַחֲנוּן אָתָּה"}, {"start": 1477.224, "end": 1480.8, "lang": "he", "text": "בָּרוּךְ אַתָּה אֲדוֹנָי, שׁוֹמֵעַ תְּפִלָּה."}, {"start": 1480.8, "end": 1482.576, "lang": "he", "text": "בָּרוּךְ"}, {"start": 1484.424, "end": 1486.2, "lang": "ar", "text": "مُبارَك."}, {"start": 1486.2, "end": 1487.976, "lang": "he", "text": "אַתָּה"}, {"start": 1487.976, "end": 1489.368, "lang": "ar", "text": "أَنتَ"}, {"start": 1491.72, "end": 1493.784, "lang": "he", "text": "שׁוֹמֵעַ תְּפִלָּה"}, {"start": 1493.784, "end": 1496.064, "lang": "ar", "text": "سامِعُ الصَّلاةِ."}, {"start": 1501.896, "end": 1505.472, "lang": "he", "text": "בָּרוּךְ אַתָּה אֲדוֹנָי, שׁוֹמֵעַ תְּפִלָּה"}, {"start": 1510.464, "end": 1514.04, "lang": "he", "text": "בָּרוּךְ אַתָּה אֲדוֹנָי, שׁוֹמֵעַ תְּפִלָּה"}, {"start": 1526.472, "end": 1531.536, "lang": "he", "text": "יְהִי רָצוֹן מִלְּפָנֶיךָ, אֲדוֹנָי אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ."}, {"start": 1531.536, "end": 1537.176, "lang": "he", "text": "שֶׁתּוֹלִיכֵנוּ לְשָׁלוֹם, וְתַצְעִידֵנוּ לְשָׁלוֹם, וְתַדְרִיכֵנוּ לְשָׁלוֹם."}, {"start": 1537.176, "end": 1542.192, "lang": "he", "text": "וְתַגִּיעֵנוּ לִמְחוֹז חֶפְצֵנוּ, לְחַיִּים וּלְשִׂמְחָה וּלְשָׁלוֹם."}, {"start": 1542.192, "end": 1547.328, "lang": "he", "text": "וְתַצִּילֵנוּ מִכַּף כָּל אוֹיֵב וְאוֹרֵב וְלִסְטִים וְחַיּוֹת רָעוֹת בַּדֶּרֶךְ."}, {"start": 1547.328, "end": 1551.432, "lang": "he", "text": "וּמִכָּל מִינֵי פֻּרְעָנֻיּוֹת הַמִּתְרַגְּשׁוֹת לָבוֹא לָעוֹלָם."}, {"start": 1551.432, "end": 1554.744, "lang": "he", "text": "וְתִשְׁלַח בְּרָכָה בְּכָל מַעֲשֵׂה יָדֵינוּ."}, {"start": 1554.744, "end": 1560.408, "lang": "he", "text": "וְתִתְּנֵנִי לְחֵן וּלְחֶסֶד וּלְרַחֲמִים, בְּעֵינֶיךָ וּבְעֵינֵי כָל רוֹאֵינוּ."}, {"start": 1560.408, "end": 1563.336, "lang": "he", "text": "וְתִשְׁמַע קוֹל תַּחֲנוּנֵינוּ."}, {"start": 1563.336, "end": 1566.624, "lang": "he", "text": "כִּי אֵל שׁוֹמֵעַ תְּפִלָּה וְתַחֲנוּן אָתָּה."}, {"start": 1566.624, "end": 1570.2, "lang": "he", "text": "בָּרוּךְ אַתָּה אֲדוֹנָי, שׁוֹמֵעַ תְּפִלָּה."}, {"start": 1577.256, "end": 1581.624, "lang": "ar", "text": "اللَّهُمَّ إِنّا نَسأَلُكَ في سَفَرِنا هٰذا البِرَّ والتَّقوى."}, {"start": 1583.376, "end": 1588.464, "lang": "ar", "text": "أَعوذُ بِكَ مِنْ وَعْثاءِ السَّفَرِ وكَآبةِ المَنظَرِ وسوءِ المُنقَلَب."}, {"start": 1613.184, "end": 1614.96, "lang": "he", "text": "שָׁלוֹם"}, {"start": 1616.784, "end": 1618.56, "lang": "ar", "text": "سَلامٌ"}]