          "text": "ڤِتِشمَع كول تَخَنونينو"
        },
        {
          "role": "gloss",
          "text": "8 · and hear the voice of our supplication"
        }
      ]
    },
    {
      "type": "verse",
      "time": 1563.436,
      "lines": [
        {
          "role": "he",
          "text": "כִּי אֵל שׁוֹמֵעַ תְּפִלָּה וְתַחֲנוּן אָתָּה"
        },
        {
          "role": "translit",
          "text": "كي إيل شوميعَ تْفِلّا ڤِتَخَنون آتّا"
        },
        {
          "role": "gloss",
          "text": "9 · for You are a God who hears prayer and supplication"
        }
      ]
    },
    {
      "type": "verse",
      "time": 1566.724,
      "lines": [
        {
          "role": "he",
          "text": "בָּרוּךְ אַתָּה אֲדוֹנָי, שׁוֹמֵעַ תְּפִלָּה"
        },
        {
          "role": "translit",
          "text": "باروخ أَتّا أَدوناي، شوميعَ تْفِلّا"
        },
        {
          "role": "gloss",
          "text": "10 · Blessed are You, Lord, who hears prayer"
        }
      ]
    },
    {
      "type": "verse",
      "time": 1572.513,
      "lines": [
        {
          "role": "ar",
          "text": "اللَّهُمَّ إِنّا نَسأَلُكَ في سَفَرِنا هٰذا البِرَّ والتَّقوى"
        },
        {
          "role": "gloss",
          "text": "O God, we ask You on this journey of ours for righteousness and piety"
        }
      ]
    },
    {
      "type": "verse",
      "time": 1581.699,
      "lines": [
        {
          "role": "ar",
          "text": "أَعوذُ بِكَ مِنْ وَعْثاءِ السَّفَرِ وكَآبةِ المَنظَرِ وسوءِ المُنقَلَب"
        },
        {
          "role": "gloss",
          "text": "I take refuge in You from the hardship of the journey, the gloom of the sight, and an evil return"
        }
      ]
